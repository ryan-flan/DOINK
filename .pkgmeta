# BigWigs packager: builds the addon-only zip for CurseForge and Wago.
# The addon lives in addon/DOINK; nothing else in the repo (companion,
# tests, docs) goes into the zip. The companion ships on GitHub Releases.
package-as: DOINK

move-folders:
  DOINK/addon/DOINK: DOINK

ignore:
  - addon
  - companion
  - .github
  - .gitattributes
  - .gitignore
  - CLAUDE.md
  - README.md
